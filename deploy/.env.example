# Copy to deploy/.env and fill in. Never commit deploy/.env.
SITE_URL=https://typo.example.org
HTTP_PORT=80
USER_AGENT=Mozilla/5.0 (compatible; JTypoSquatting/2.0; +https://typo.example.org/fr/faq)

MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Any S3-compatible storage; the bucket must exist
S3_ENDPOINT=https://s3.example.org
S3_REGION=fr-par
S3_BUCKET=jtypo-screenshots
S3_ACCESS_KEY=
S3_SECRET_KEY=

# OpenID Connect provider (redirect URI to register: https://<site>/login/oauth2/code/oidc)
OIDC_ISSUER_URI=https://auth.example.org/realms/jtypo
OIDC_CLIENT_ID=jtypo-web
OIDC_CLIENT_SECRET=

WORKER_REPLICAS=2
